# /etc/tennis-monitor.env 로 복사해 값을 채우세요.
#   sudo install -m 600 -o root -g root monitor.env.example /etc/tennis-monitor.env
# systemd는 이 파일을 읽을 때 따옴표와 # 주석을 처리합니다. 값에는 공백 없이 입력하세요.

# Render에 배포한 Webpage 주소 (https만 허용)
WEBPAGE_URL=https://YOUR-SERVICE.onrender.com
# Webpage의 WEBPAGE_INGEST_TOKEN과 같은 값. 길고 추측하기 어려운 무작위 문자열을 사용하세요.
# 생성 예: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBPAGE_INGEST_TOKEN=
